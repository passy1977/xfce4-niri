#!/bin/bash

for cmd in swayidle swaylock; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: '$cmd' is not installed or not in PATH." >&2
        exit 1
    fi
done

if [ -z "$1" ] || [ -z "$2" ]; then
    loginctl lock-session "$XDG_SESSION_ID"
    exit 0
fi

# the user's config wins, the packaged one in /etc/niri is the fallback
SWAYLOCK_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/niri/swaylock/config"
[ -f "$SWAYLOCK_CONF" ] || SWAYLOCK_CONF=/etc/niri/swaylock/config

SWAYLOCK_CMD="swaylock -f -C '$SWAYLOCK_CONF'"

swayidle -w \
    timeout "$1" "$SWAYLOCK_CMD" \
    timeout "$2" "niri msg action power-off-monitors" \
    resume "niri msg action power-on-monitors" \
    lock "$SWAYLOCK_CMD" \
    before-sleep "$SWAYLOCK_CMD" &

sleep 1
