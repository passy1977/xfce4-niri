#!/bin/bash

for cmd in swayidle swaylock; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: '$cmd' is not installed or not in PATH." >&2
        exit 1
    fi
done

if [ -z "$1" ] || [ -z "$2" ]; then
    loginctl lock-session $XDG_SESSION_ID
    exit 0
fi

swayidle -w \
    timeout $1 "swaylock -f -C ~/.config/niri/swaylock/config" \
    timeout $2 "niri msg action power-off-monitors" \
    resume "niri msg action power-on-monitors" \
    lock "swaylock -f -C ~/.config/niri/swaylock/config" \
    before-sleep "swaylock -f -C ~/.config/niri/swaylock/config" &

sleep 1
