#!/bin/bash
#
# xfce4-niri-set-cursor - apply an XCursor theme consistently across a niri + xfce4 session.
#
# Usage:
#   xfce4-niri-set-cursor                 list installed cursor themes
#   xfce4-niri-set-cursor THEME [SIZE]    apply THEME (default size: 24)
#
# Updates, in order:
#   1. niri          niri.d/35-cursor.kdl (included from niri.d/_index.kdl)
#   2. GSettings     org.gnome.desktop.interface cursor-theme/cursor-size
#   3. xfconf        xsettings /Gtk/CursorThemeName, /Gtk/CursorThemeSize
#   4. GTK ini       gtk-3.0/settings.ini (and gtk-4.0 if present)
#   5. XCursor       ~/.icons/default/index.theme fallback
# and finally restarts xfce4-panel, if running.

set -eu

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
NIRI_DIR="$CONFIG_HOME/niri"
NIRI_INDEX="$NIRI_DIR/niri.d/_index.kdl"
NIRI_CURSOR="$NIRI_DIR/niri.d/35-cursor.kdl"
DEFAULT_SIZE=24

icon_dirs() {
    echo "$HOME/.local/share/icons"
    echo "$HOME/.icons"
    local IFS=:
    for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
        echo "$d/icons"
    done
}

list_themes() {
    icon_dirs | while read -r dir; do
        for t in "$dir"/*/; do
            [ -d "${t}cursors" ] && basename "$t"
        done
    done | sort -u || true
}

find_theme() {
    icon_dirs | while read -r dir; do
        [ -d "$dir/$1/cursors" ] && echo "$dir/$1" && break
    done
}

warn() {
    echo "Warning: $*" >&2
}

# Set KEY=VALUE in the [Settings] section of a GTK settings.ini, creating it if needed.
set_ini_key() {
    local file="$1" key="$2" value="$3"
    if [ ! -f "$file" ]; then
        mkdir -p "$(dirname "$file")"
        printf '[Settings]\n' > "$file"
    fi
    if grep -q "^$key=" "$file"; then
        sed -i "s|^$key=.*|$key=$value|" "$file"
    elif grep -q '^\[Settings\]' "$file"; then
        sed -i "/^\[Settings\]/a $key=$value" "$file"
    else
        printf '[Settings]\n%s=%s\n' "$key" "$value" >> "$file"
    fi
}

if [ $# -eq 0 ]; then
    list_themes
    exit 0
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

THEME="$1"
SIZE="${2:-$DEFAULT_SIZE}"

if ! [[ "$SIZE" =~ ^[0-9]+$ ]] || [ "$SIZE" -lt 8 ] || [ "$SIZE" -gt 256 ]; then
    echo "Error: size must be an integer between 8 and 256, got '$SIZE'." >&2
    exit 1
fi

THEME_PATH="$(find_theme "$THEME" || true)"
if [ -z "$THEME_PATH" ]; then
    echo "Error: cursor theme '$THEME' not found. Installed themes:" >&2
    list_themes | sed 's/^/  /' >&2
    exit 1
fi

# 1. niri
if [ -f "$NIRI_INDEX" ]; then
    other="$(grep -lE '^\s*cursor\s*\{' "$NIRI_DIR"/config.kdl "$NIRI_DIR"/niri.d/*.kdl 2>/dev/null \
        | grep -vF "$NIRI_CURSOR" || true)"
    if [ -n "$other" ]; then
        warn "another 'cursor {}' block exists in: $other - remove it to avoid conflicts."
    fi

    backup=""
    [ -f "$NIRI_CURSOR" ] && backup="$(cat "$NIRI_CURSOR")"

    cat > "$NIRI_CURSOR" <<EOF
// niri.d/35-cursor.kdl
// Generated by bin/xfce4-niri-set-cursor - do not edit by hand, rerun the script instead.
// Reference: https://niri-wm.github.io/niri/Configuration:-Miscellaneous#cursor

cursor {
    xcursor-theme "$THEME"
    xcursor-size $SIZE
}
EOF

    if ! grep -q '^include "35-cursor.kdl"' "$NIRI_INDEX"; then
        if grep -q '^include "30-appearance.kdl"' "$NIRI_INDEX"; then
            sed -i '/^include "30-appearance.kdl"/a include "35-cursor.kdl"' "$NIRI_INDEX"
        else
            echo 'include "35-cursor.kdl"' >> "$NIRI_INDEX"
        fi
    fi

    if command -v niri >/dev/null 2>&1 && ! niri validate -c "$NIRI_DIR/config.kdl" >/dev/null 2>&1; then
        if [ -n "$backup" ]; then
            printf '%s\n' "$backup" > "$NIRI_CURSOR"
        else
            rm -f "$NIRI_CURSOR"
            sed -i '/^include "35-cursor.kdl"/d' "$NIRI_INDEX"
        fi
        echo "Error: niri rejected the new config, changes reverted. Run 'niri validate' for details." >&2
        exit 1
    fi
    echo "niri:      $NIRI_CURSOR"
else
    warn "$NIRI_INDEX not found, skipping niri."
fi

# 2. GSettings (GTK3/GTK4 on Wayland)
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface cursor-theme "$THEME" \
        && gsettings set org.gnome.desktop.interface cursor-size "$SIZE" \
        && echo "gsettings: org.gnome.desktop.interface" \
        || warn "gsettings failed."
fi

# 3. xfconf (xsettings, read by XWayland clients and xfce4 components)
if command -v xfconf-query >/dev/null 2>&1; then
    xfconf-query -c xsettings -p /Gtk/CursorThemeName -n -t string -s "$THEME" \
        && xfconf-query -c xsettings -p /Gtk/CursorThemeSize -n -t int -s "$SIZE" \
        && echo "xfconf:    xsettings /Gtk/CursorTheme*" \
        || warn "xfconf-query failed (is xfconfd running?)."
fi

# 4. GTK settings.ini
for v in 3.0 4.0; do
    ini="$CONFIG_HOME/gtk-$v/settings.ini"
    [ "$v" = "4.0" ] && [ ! -f "$ini" ] && continue
    set_ini_key "$ini" gtk-cursor-theme-name "$THEME"
    set_ini_key "$ini" gtk-cursor-theme-size "$SIZE"
    echo "gtk-$v:   $ini"
done

# 5. XCursor fallback for clients that read none of the above
mkdir -p "$HOME/.icons/default"
printf '[Icon Theme]\nInherits=%s\n' "$THEME" > "$HOME/.icons/default/index.theme"
echo "xcursor:   $HOME/.icons/default/index.theme"

if pgrep -x xfce4-panel >/dev/null 2>&1; then
    xfce4-panel -r >/dev/null 2>&1 &
    echo "Restarted xfce4-panel."
fi

echo "Cursor set to '$THEME' ($SIZE px). Already running apps pick it up after a restart."
